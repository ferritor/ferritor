  "query": "SELECT v.version, v.created_at, v.deleted_at\n                 FROM paths p JOIN secret_versions v ON v.path_id = p.id\n                 WHERE p.path = $1 AND v.version < $2::int8\n                 ORDER BY v.version DESC\n                 LIMIT $3",
