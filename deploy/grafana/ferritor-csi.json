    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "failed: transient (the volume stays as it is); refused: authoritative; invalid: the SecretProviderClass",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
