# Development only: copy to .env. Matches compose.yaml. Nothing here is needed
# in production (see docs/src/content/docs/reference/configuration.md and docs/src/content/docs/contributing/development.md).

# For the build and the tests, not the server: the sqlx `query!` macros check
# every query against these live databases at compile time, and sqlx-cli and
# the store and server tests use them too. Without them (or with
# SQLX_OFFLINE=true) the build uses the committed .sqlx/ caches instead,
# which is how a production build works.
KEYS_DATABASE_URL=postgres://ferritor:ferritor@localhost:5433/ferritor_keys
DATA_DATABASE_URL=postgres://ferritor:ferritor@localhost:5434/ferritor_data

# For the server (development convenience: it loads .env at startup). The
# same databases, so the same URLs. In production set these, or the keys in
# ferritor.toml, from your secret store. Every other server setting is
# documented in ferritor.example.toml; any of them can be set here too
# (FERRITOR_ + the key in capitals, nested keys with `__`).
FERRITOR_KEYS_DATABASE_URL=${KEYS_DATABASE_URL}
FERRITOR_DATA_DATABASE_URL=${DATA_DATABASE_URL}

# Metrics (OpenTelemetry), environment only: exported over OTLP/gRPC only if
# an endpoint is set. https:// (or no scheme) is TLS with the public roots;
# http:// is plaintext, for a local agent. A private CA, and a client
# certificate for mTLS:
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#OTEL_EXPORTER_OTLP_CERTIFICATE=collector-ca.pem
#OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=ferritor-otlp.pem
#OTEL_EXPORTER_OTLP_CLIENT_KEY=ferritor-otlp-key.pem
#OTEL_METRIC_EXPORT_INTERVAL=60000
